    # A colonizable Gan Eden site is represented as a PlanetAPI so vanilla's
    # survey/colony UI remains available, but it is drawn as a compact fixed
    # installation rather than as a free-floating world.
    "ship_trophy_gan_eden_surface_site":{
        # Campaign tooltips prepend the PlanetAPI's proper name and append
        # "World" to this type label. Keep the label descriptive rather than
        # repeating the settlement name (for example, "Tree of Life, Terran
        # World" instead of "Tree of Life, Tree of Life ... World").
        "name":"Artificial",
        "tilt":0,
        "pitch":0,
        "rotation":0,
        "planetColor":[255,255,255,255],
        "atmosphereThickness":0,
        "atmosphereThicknessMin":0,
        "atmosphereColor":[0,0,0,0],
        "texture":"graphics/icons/gan_eden_settlements/cinderwake_surface.png",
        "icon":"graphics/icons/gan_eden_settlements/cinderwake.png",
        "starscapeIcon":"graphics/icons/gan_eden_settlements/cinderwake.png",
        "iconColor":[190,195,200,255],
        "scaleMultMapIcon":0.7,
        "scaleMultStarscapeIcon":0.7,
        "lightPosition":[0,0,10],
    },
